# Значения задаются переменными окружения (например, через systemd Environment=
# или `export` перед запуском). Секреты в коде не хранятся.

# Токен бота из @BotFather
ALMAZ_BOT_TOKEN=

# Telegram ID владельца бота — только он управляет паролем панели и
# полноправными админами. Свой ID можно узнать у @userinfobot.
# Несколько — через запятую.
ROOT_OWNER_IDS=

# Числовой ID канала, куда падают заявки на выплату (например -1001234567890).
# 0 — выплаты через канал отключены.
PAY_CHANNEL=0

# Публичный HTTPS-адрес мини-аппа отзывов. Пусто — раздел отзывов скрыт.
REVIEWS_URL=
